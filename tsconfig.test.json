{
  "extends": "./tsconfig.node.json",
  "include": [
    "test/**/*.ts",
    "test-e2e/**/*.ts",
    "src/main/**/*.ts",
    "src/shared/**/*.d.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "types": ["node", "vitest/globals", "electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@main/*": ["./src/main/*"]
    }
  }
}
