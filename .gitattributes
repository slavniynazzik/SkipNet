# Keep executable/binary resources byte-for-byte identical on every platform.
* text=auto eol=lf

# Windows scripts and NSIS includes are consumed by cmd.exe / makensis and
# must stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.nsh text eol=crlf
*.nsi text eol=crlf

# Binaries (do not apply text conversion or diffs).
*.exe binary
*.dll binary
*.sys binary
*.bin binary
*.7z binary
*.zip binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
